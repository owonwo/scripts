engine biome(1.0)
language js(typescript, jsx)

// Match: const UpperCase = (...) => ...
// Suggests converting to function declaration
`const $name = $arrow` as $decl where {
    $name <: r"[A-Z].*",
    register_diagnostic(
        span = $decl,
        message = "Arrow function component should be a function declaration.",
        severity = "hint"
    )
}
